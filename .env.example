# Base de datos
DATABASE_PROVIDER=supabase
DATABASE_URL=
DATABASE_KEY=

# API keys de LLM — completar solo las del provider que se use en cada agente
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Provider y modelo por agente (provider: claude | openai | gemini)
FINANCIAL_AGENT_PROVIDER=
FINANCIAL_AGENT_MODEL=

CONVERSATION_AGENT_PROVIDER=
CONVERSATION_AGENT_MODEL=

REPORT_AGENT_PROVIDER=
REPORT_AGENT_MODEL=

ROUTER_PROVIDER=
ROUTER_MODEL=

# Mensajería
MESSAGING_PROVIDER=telegram
MESSAGING_MODE=webhook
MESSAGING_PORT=8000

# Variables específicas de Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_PATH=/webhook
TELEGRAM_WEBHOOK_URL=    # URL pública del servidor. En local: URL de Ngrok. En prod: URL del deploy.
