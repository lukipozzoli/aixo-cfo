# Base de datos
DATABASE_PROVIDER=supabase
DATABASE_URL=
DATABASE_KEY=

# API keys de LLM — completar solo las del provider que se use en cada agente
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Provider y modelo por agente (provider: claude | openai | gemini)
FINANCIAL_AGENT_PROVIDER=
FINANCIAL_AGENT_MODEL=

ROUTER_PROVIDER=
ROUTER_MODEL=

ORCHESTRATOR_PROVIDER=
ORCHESTRATOR_MODEL=

# Mensajería — qué canal usa el agente para hablar con el usuario
MESSAGING_PROVIDER=telegram

# Transcripción de audio (voz → texto)
TRANSCRIPTION_PROVIDER=whisper
TRANSCRIPTION_MODEL=whisper-1

# Visión — análisis de imágenes y documentos
VISION_PROVIDER=claude
VISION_MODEL=

# ── Telegram ─────────────────────────────────────────────────────────────────
# SOLO si MESSAGING_PROVIDER=telegram. Con otro proveedor, todo este bloque se
# puede borrar: el sistema arranca igual sin ninguna de estas variables.

TELEGRAM_BOT_TOKEN=
MESSAGING_MODE=polling       # polling | webhook
MESSAGING_PORT=8000          # puerto del servidor; solo se usa en modo webhook
TELEGRAM_WEBHOOK_PATH=/webhook

# Opcional: solo en modo webhook. URL pública del servidor.
# En local, la URL de Ngrok. En producción, la del deploy.
TELEGRAM_WEBHOOK_URL=

# Opcional: a dónde escribe el agente cuando manda un mensaje sin que nadie haya
# preguntado (reportes diarios, alertas). Todavía no lo usa nada — se puede
# dejar vacío.
TELEGRAM_CHAT_ID=
